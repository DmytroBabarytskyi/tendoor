# Скопіюйте в .env і змініть паролі для не-локального середовища
POSTGRES_DB=tendoor
POSTGRES_USER=tendoor
POSTGRES_PASSWORD=tendoor

# Для запуску бекенду поза Docker (uv run …)
TENDOOR_POSTGRES_DSN=postgresql+asyncpg://tendoor:tendoor@localhost:5432/tendoor
TENDOOR_MONGO_URI=mongodb://localhost:27017
TENDOOR_MONGO_DB=tendoor
